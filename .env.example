# Anthropic Messages API (the only backend implemented)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: some Anthropic-compatible gateways use a bearer token instead.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: gateway / proxy base URL
ANTHROPIC_BASE_URL=

# Optional: Anthropic native extended thinking.
# Thinking is printed to the CLI but never written to session/transcript/trace.
ANTHROPIC_THINKING=0
ANTHROPIC_THINKING_BUDGET=2048
# Print thinking to the CLI (default on).
ANTHROPIC_SHOW_THINKING=1
# Keep thinking in memory across turns (never written to disk).
ANTHROPIC_KEEP_THINKING_IN_MEMORY=0

# Optional: move runtime data out of the repo.
# Default is the repo root, with sessions/, memory/, logs/, artifacts/.
MINI_AGENT_HOME=
